# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
build/
dist/
eggs/
*.egg-info/
pip-wheel-metadata/

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Virtual environments
.venv/
venv/
env/
ENV/
.env
env.bak/
requirements-lock.txt

# PyInstaller
*.manifest
*.spec

# Unit test / coverage
.coverage
.coverage.*
.cache
.pytest_cache/
htmlcov/
.tox/

# mypy
.mypy_cache/

# Editors
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# OS files
.DS_Store
Thumbs.db

# Logs and databases
*.log
logs/
*.sqlite3
*.db
*.db-wal
*.db-shm

# Runtime/state files
.bot.lock
.bot.pid
.last_start.txt
state.json
*.state.json
.bot_state*.json
.tmp_*
settings.toml
.resume_cache/
resumes_cache/

# Message listing / deduplication files (runtime)
.message_listing_*.json
.message_listings/
dedup_listings/
.reddit_seen_*.json
*.listing_*.json

# Secrets / keys / env files
.env
.env.*
*.key
*.pem
secrets.json
secrets*.json
*_secrets.json
*_credentials.json
credentials.json
token.json
tokens.json
auth.json
service_account*.json
*_token.txt
*.secret

# Claude AI local settings (may contain API keys)
.claude/settings.local.json

# VPN credentials and configs (never commit these)
vpn/auth.txt
vpn/*.ovpn
vpn/*.conf

# Chrome profile (contains session cookies — never commit)
chrome_profile/
chrome_profile_runtime/

# Misc
node_modules/

# Local ML models / weights
models/sentence-transformers_all-MiniLM-L6-v2/
models/**/pytorch_model.bin
models/**/*.safetensors
models/**/*.onnx
models/**/*.pt
models/**/*.pth
models/**/*.ckpt
models/**/*.gguf

# Nested ATS company list repo (has its own git history)
data/ats_companies/

# Common Crawl harvest, republished weekly to the ats-harvest orphan branch by
# .github/workflows/ats-harvest.yml and pulled by sync_ats_companies.py. Same
# reasoning as data/ats_companies: regenerable, rewritten on a schedule, and
# committing it would put a full-list diff in main every week.
data/ats_harvest/
# The same harvest as published by .github/workflows/ats-harvest.yml,
# pulled by sync_ats_companies.py. Derived, rewritten every sync.
data/ats_harvest_ci/

# Which harvested slugs were last confirmed live, written by
# scripts/validate_ats_slugs.py. Regenerable runtime state, same as the harvest
# it annotates.
data/ats_checked/

# GeoNames sources. Published weekly to the `geonames-data` branch by
# .github/workflows/geonames-sync.yml and pulled by sync_geonames.py,
# so main does not carry them -- cities500.txt is 40MB and would otherwise add
# that to history on every refresh. Untrack an existing checkout with:
#   git rm --cached data/geonames_raw/cities500.txt data/geonames_raw/admin1CodesASCII.txt
data/geonames_raw/

# Large archives / dataset dumps
*.zip
# Allow job archive zips -- weekly and consolidated monthly alike. The bot
# commits these itself (merge_data.commit_archives), gated on
# JBA_ARCHIVE_GIT_COMMIT.
!data/jba/jobs/*/*.zip
*.7z
*.tar
*.tar.gz
*.tgz
*.bz2
*.xz

# Derived index rebuilt from data/jba/jobs/**/*.zip on demand; not source of truth.
data/jba/jobs/archive_index.db
data/jba/jobs/archive_index.db-shm
data/jba/jobs/archive_index.db-wal

# Resume-quality lab: harness, frozen JD corpus, scored build outputs and PDFs.
# Contains scraped posting text and generated resumes — working data, not source.
.resume_lab/

# ATS validation run reports (baseline in data/ats_baseline.json is tracked)
.ats_validation/
