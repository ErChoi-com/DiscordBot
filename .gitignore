models/**/*.safetensors
models/**/*.onnx
models/**/*.pt
models/**/*.pth
models/**/*.ckpt
models/**/*.gguf

# Nested ATS company list repo (has its own git history)
data/ats_companies/

# Large archives / dataset dumps
*.zip
